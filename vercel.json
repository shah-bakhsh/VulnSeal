{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://vulnseal.onrender.com/api/:match*"
    },
    {
      "source": "/demo-target/:match*",
      "destination": "https://vulnseal.onrender.com/demo-target/:match*"
    },
    {
      "source": "/demo-target",
      "destination": "https://vulnseal.onrender.com/demo-target"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
