# VulnSeal Environment Configuration
APP_ENV=development
PORT=8000
FRONTEND_PORT=3000

# Backend & Frontend URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./vulnseal.db

# AI Inference Providers (Optional: Deterministic AST Engine runs automatically without API keys)
# GEMINI_API_KEY: Optional Google Gemini API key for AI reasoning and patch synthesis
GEMINI_API_KEY=

# GROQ_API_KEY: Optional Groq Cloud API key (e.g. llama-3.3-70b-versatile)
GROQ_API_KEY=

# Demo Target Sandbox Configuration
DEMO_TARGET_HOST=localhost
DEMO_TARGET_PORT=8000
DEMO_TARGET_PATH=/demo-target

# Supabase PostgreSQL Database (Optional Cloud Sync)
SUPABASE_URL=
SUPABASE_ANON_KEY=
